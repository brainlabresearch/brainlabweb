# Keep LF in the repository regardless of what Windows does locally.
# Without this, fetch-headshots.sh gets committed with CRLF line endings and
# fails to run on macOS or Linux.
* text=auto eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Lecture slides. Not optional: `text=auto` above guesses, and a PDF guessed
# wrong gets its CRLFs rewritten on checkout, which corrupts the file silently —
# it downloads and then fails to open.
*.pdf binary
*.pptx binary
